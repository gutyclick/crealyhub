# Public Supabase values. These are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Current Supabase/Vercel integrations may provide this instead of ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Current Supabase/Vercel integrations may provide this instead of SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/instagram/callback
META_GRAPH_API_VERSION=v25.0

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_TIMEZONE=America/Panama
AUTOPILOT_ENABLED=false
SUPABASE_STORAGE_BUCKET=content-media

# AI defaults
OPENAI_STRATEGY_MODEL=gpt-5.6-terra
OPENAI_COPY_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_REQUEST_TIMEOUT_MS=90000

# Guardrails
CONTENT_BUFFER_DAYS=5
TARGET_CONTENT_PER_DAY=3
MONTHLY_AI_BUDGET_USD=100
MAX_IMAGES_PER_DAY=12
MAX_REGENERATIONS_PER_POST=3
MAX_CONCURRENT_GENERATIONS=2
MAX_CONCURRENT_IMAGE_GENERATIONS=2
AI_TEXT_INPUT_USD_PER_MILLION=2.5
AI_TEXT_OUTPUT_USD_PER_MILLION=15
AI_IMAGE_INPUT_USD_PER_MILLION=8
AI_IMAGE_OUTPUT_USD_PER_MILLION=32
